{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://crt-station.invalid/schemas/native-single-run.response.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "operation", "run_id", "proposal_id", "status", "phase_reached", "scheduler_invoked", "validation_context", "affected_channels", "channels", "verification", "preservation", "path_validation", "guide_validation", "warnings", "failure", "timings_ms", "diagnostics"],
  "properties": {
    "schema_version": {"const": 1},
    "operation": {"const": "native_single_run"},
    "run_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "proposal_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["success", "failed"]},
    "phase_reached": {"enum": ["request", "probes", "snapshot", "seed", "native_import", "configuration", "catalog", "scheduler", "preservation", "guide", "complete"]},
    "scheduler_invoked": {"type": "boolean"},
    "validation_context": {
      "type": "object", "additionalProperties": false,
      "required": ["input_fingerprint", "requested_seed", "effective_seed"],
      "properties": {
        "input_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "requested_seed": {"type": "integer"},
        "effective_seed": {"type": "integer", "minimum": 0}
      }
    },
    "affected_channels": {
      "type": "array", "minItems": 1, "maxItems": 6, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["number", "name"],
        "properties": {"number": {"type": "integer"}, "name": {"type": "string"}}
      }
    },
    "channels": {"type": "array", "items": {"$ref": "#/$defs/channel"}},
    "verification": {"oneOf": [{"$ref": "#/$defs/verification"}, {"type": "object", "maxProperties": 0}]},
    "preservation": {"oneOf": [{
      "type": "object", "additionalProperties": false,
      "required": ["retained_history", "protected_channels", "sequence_tables_restored", "foreign_key_baseline"],
      "properties": {
        "retained_history": {"const": "pass"}, "protected_channels": {"const": "pass"},
        "sequence_tables_restored": {"const": "pass"}, "foreign_key_baseline": {"const": "pass"}
      }
    }, {"type": "object", "maxProperties": 0}]},
    "path_validation": {"oneOf": [{
      "type": "object", "additionalProperties": false,
      "required": ["passed", "mapping_count", "scheduled_path_checks"],
      "properties": {
        "passed": {"const": true}, "mapping_count": {"type": "integer", "minimum": 0},
        "scheduled_path_checks": {"type": "integer", "minimum": 0}
      }
    }, {"type": "object", "maxProperties": 0}]},
    "guide_validation": {"oneOf": [{"$ref": "#/$defs/guide_validation"}, {"type": "object", "maxProperties": 0}]},
    "warnings": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/diagnostic"}},
    "failure": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/diagnostic"}]},
    "timings_ms": {"oneOf": [{
      "type": "object", "additionalProperties": false,
      "required": ["prepare", "catalog", "scheduler", "preservation", "guide", "total"],
      "properties": {
        "prepare": {"type": "integer", "minimum": 0},
        "catalog": {"type": "integer", "minimum": 0},
        "scheduler": {"type": "integer", "minimum": 0},
        "preservation": {"type": "integer", "minimum": 0},
        "guide": {"type": "integer", "minimum": 0},
        "total": {"type": "integer", "minimum": 0}
      }
    }, {"type": "object", "maxProperties": 0}]},
    "diagnostics": {
      "type": "object", "additionalProperties": false,
      "required": ["messages", "truncated"],
      "properties": {
        "messages": {"type": "array", "maxItems": 100, "items": {"type": "string", "maxLength": 1000}},
        "truncated": {"type": "boolean"}
      }
    }
  },
  "$defs": {
    "guide_boundary": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "instant", "match_count", "title"],
      "properties": {
        "name": {"type": "string", "maxLength": 100},
        "instant": {"type": "string"},
        "match_count": {"type": "integer", "minimum": 0, "maximum": 1},
        "title": {"type": ["string", "null"], "maxLength": 1000}
      }
    },
    "guide_channel": {
      "type": "object", "additionalProperties": false,
      "required": ["number", "name", "network_long_name", "hidden", "has_schedule", "listing_count", "transition_probe_count", "zero_match_count", "one_match_count", "named_boundaries", "named_boundaries_truncated"],
      "properties": {
        "number": {"type": "integer"}, "name": {"type": "string"},
        "network_long_name": {"type": "string"}, "hidden": {"type": "boolean"},
        "has_schedule": {"const": true},
        "listing_count": {"type": "integer", "minimum": 0},
        "transition_probe_count": {"type": "integer", "minimum": 0},
        "zero_match_count": {"type": "integer", "minimum": 0},
        "one_match_count": {"type": "integer", "minimum": 0},
        "named_boundaries": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/guide_boundary"}},
        "named_boundaries_truncated": {"type": "boolean"}
      }
    },
    "guide_validation": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "primary_failure", "snapshot_preparation", "snapshot_verification", "post_read_verification", "errors", "errors_truncated"],
      "properties": {
        "status": {"enum": ["pass", "failed"]},
        "primary_failure": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/guide_primary_failure"}]},
        "snapshot_preparation": {"$ref": "#/$defs/guide_verification"},
        "snapshot_verification": {"$ref": "#/$defs/guide_verification"},
        "post_read_verification": {"$ref": "#/$defs/guide_verification"},
        "format_version": {"const": 1},
        "artifact_identity": {"const": "guide/guide-v1.records"},
        "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "record_count": {"type": "integer", "minimum": 1, "maximum": 100000},
        "byte_count": {"type": "integer", "minimum": 13, "maximum": 67108864},
        "channels": {"type": "array", "minItems": 1, "maxItems": 6, "items": {"$ref": "#/$defs/guide_channel"}},
        "errors": {"type": "array", "maxItems": 50, "items": {"$ref": "#/$defs/diagnostic"}},
        "errors_truncated": {"type": "boolean"}
      },
      "allOf": [{
        "if": {"properties": {"status": {"const": "pass"}}},
        "then": {
          "required": ["format_version", "artifact_identity", "digest", "record_count", "byte_count", "channels"],
          "properties": {
            "primary_failure": {"type": "null"},
            "snapshot_preparation": {"properties": {"status": {"const": "pass"}}},
            "snapshot_verification": {"properties": {"status": {"const": "pass"}}},
            "post_read_verification": {"properties": {"status": {"const": "pass"}}}
          }
        },
        "else": {
          "not": {"anyOf": [{"required": ["artifact_identity"]}, {"required": ["digest"]}, {"required": ["channels"]}]}
        }
      }]
    },
    "guide_primary_failure": {
      "type": "object", "additionalProperties": false,
      "required": ["phase", "code", "message"],
      "properties": {
        "phase": {"enum": ["guide_snapshot", "guide_read"]},
        "code": {"enum": ["guide_loading_failed", "guide_validation_failed"]},
        "message": {"type": "string", "minLength": 1, "maxLength": 1000}
      }
    },
    "guide_verification": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "message"],
      "properties": {
        "status": {"enum": ["pass", "failed", "not_run"]},
        "message": {"type": ["string", "null"], "maxLength": 1000}
      }
    },
    "diagnostic": {
      "type": "object", "additionalProperties": false,
      "required": ["phase", "channel", "code", "type", "message"],
      "properties": {
        "phase": {"type": "string", "minLength": 1},
        "channel": {"type": ["string", "null"]},
        "code": {"type": "string", "minLength": 1},
        "type": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1, "maxLength": 1000}
      }
    },
    "channel": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "number", "channel_seed", "regeneration_start", "effective_horizon", "retained_blocks", "generated_blocks", "final_blocks", "catalog_reused", "catalog_new", "catalog_protected", "new_catalog_ids", "coverage"],
      "properties": {
        "name": {"type": "string"}, "number": {"type": "integer"},
        "channel_seed": {"type": "integer", "minimum": 0},
        "regeneration_start": {"type": "string"}, "effective_horizon": {"type": "string"},
        "retained_blocks": {"type": "integer", "minimum": 0}, "generated_blocks": {"type": "integer", "minimum": 0}, "final_blocks": {"type": "integer", "minimum": 0},
        "catalog_reused": {"type": "integer", "minimum": 0}, "catalog_new": {"type": "integer", "minimum": 0}, "catalog_protected": {"type": "integer", "minimum": 0},
        "new_catalog_ids": {"const": "provisional"},
        "coverage": {"$ref": "#/$defs/coverage"}
      }
    },
    "verification": {
      "type": "object", "additionalProperties": false,
      "required": ["original_snapshot", "deterministic_projection", "projected_configuration", "working_database", "logical_media", "physical_transition", "fingerprints"],
      "properties": {
        "original_snapshot": {"const": "pass"},
        "deterministic_projection": {"const": "pass"},
        "projected_configuration": {"const": "pass"},
        "working_database": {"const": "pass"},
        "logical_media": {"const": "pass"},
        "physical_transition": {"const": "pass"},
        "fingerprints": {"type": "object", "minProperties": 7, "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
      }
    },
    "coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["channel", "proposal_boundary_crossing_ids", "proposal_end_crossing_ids", "effective_horizon_crossing_ids", "gaps", "overlaps", "final_end"],
      "properties": {
        "channel": {"type": "string"},
        "proposal_boundary_crossing_ids": {"type": "array", "items": {"type": "integer"}},
        "proposal_end_crossing_ids": {"type": "array", "items": {"type": "integer"}},
        "effective_horizon_crossing_ids": {"type": "array", "items": {"type": "integer"}},
        "gaps": {"type": "array", "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string"}}},
        "overlaps": {"type": "array", "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string"}}},
        "final_end": {"type": ["string", "null"]}
      }
    }
  }
}
