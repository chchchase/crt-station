{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_digest",
    "code_revision",
    "run_id",
    "channels"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "request_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "code_revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "run_id": {
      "type": "string",
      "maxLength": 128,
      "minLength": 1
    },
    "channels": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "station",
          "clock",
          "rows",
          "events"
        ],
        "properties": {
          "station": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "clock": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}(\\.\\d{1,6})?$"
          },
          "rows": {
            "type": "array",
            "maxItems": 50000,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "validated_id",
                "rebuild_count",
                "reconciled_count",
                "initial_updated_at",
                "stable_digest",
                "group_digest",
                "final_count",
                "final_updated_at"
              ],
              "properties": {
                "validated_id": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9223372036854776000
                },
                "rebuild_count": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9223372036854776000
                },
                "reconciled_count": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9223372036854776000
                },
                "initial_updated_at": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}(\\.\\d{1,6})?$"
                },
                "stable_digest": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "group_digest": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "final_count": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9223372036854776000
                },
                "final_updated_at": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}(\\.\\d{1,6})?$"
                }
              }
            }
          },
          "events": {
            "type": "array",
            "maxItems": 10000,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "group_digest",
                "ids"
              ],
              "properties": {
                "group_digest": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "ids": {
                  "type": "array",
                  "maxItems": 50000,
                  "uniqueItems": true,
                  "items": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9223372036854776000
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
